# Copy to .env and fill in real values. Never commit the real .env file.

PORT=4000

# Long random string — used to sign admin JWT sessions.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# The exact URL your frontend is served from (no trailing slash).
# Local dev: http://localhost:5500
# Production: https://your-site.netlify.app
CORS_ORIGIN=http://localhost:5500

# Admin login seeded by `npm run seed` (only runs once — safe to re-run).
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=

# Optional — for emailing Contact Us / Ask the Scholar submissions.
# Leave blank to skip email sending (submissions are still saved to the DB).
GMAIL_USER=
GMAIL_APP_PASSWORD=
CONTACT_TO_EMAIL=
SCHOLAR_TO_EMAIL=
